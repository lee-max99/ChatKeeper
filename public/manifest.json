{
  "manifest_version": 3,
  "name": "ChatKeeper",
  "version": "0.3.4",
  "description": "将当前 ChatGPT 对话保存为 Markdown 或离线可读的 HTML。内容在本地处理。",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatKeeper · 导出对话",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
